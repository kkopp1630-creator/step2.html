<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>كود المرحلة 2</title>
  <style>
    body { font-family: sans-serif; text-align: center; padding: 40px 16px; background: #0b1628; color: #fff; }
    .box { background: #162b49; padding: 24px; border-radius: 14px; max-width: 360px; margin: auto; border: 1px solid #38bdf8; }
    .code { font-size: 28px; font-weight: bold; color: #7dd3fc; margin-top: 12px; letter-spacing: 2px; }
  </style>
</head>
<body>
  <div class="box">
    <div>كود المرحلة 2</div>
    <div id="codeBox" class="code">...</div>
  </div>
  <script>
    const SALT = "STAGE_2_SECRET";
    const now = new Date();
    const dateStr = now.getFullYear() + "-" +
      String(now.getMonth() + 1).padStart(2, "0") + "-" +
      String(now.getDate()).padStart(2, "0");

    let hash = 2166136261;
    const input = dateStr + "|" + SALT;
    for (let i = 0; i < input.length; i++) {
      hash ^= input.charCodeAt(i);
      hash = Math.imul(hash, 16777619);
    }
    const code = "S2-" + (hash >>> 0).toString(36).toUpperCase().slice(0, 5);
    document.getElementById("codeBox").textContent = code;
  </script>
</body>
</html>
